[Unit]
Description=CMP90HX persistent compute bootstrap before GPU consumers
After=local-fs.target systemd-modules-load.service
Before=multi-user.target graphical.target display-manager.service hive.service os-core.service hivex.service hive-watchdog.service nvidia-persistenced.service
Conflicts=display-manager.service

[Service]
Type=oneshot
Environment=CMP90_MIN_BOOT_SECONDS=15
Environment=CMP90_FIRST_CANDIDATE_SETTLE_SECONDS=2
Environment=CMP90_SUBSEQUENT_CANDIDATE_SETTLE_SECONDS=2
ExecStart=/usr/local/lib/cmp90hx-persistent/defer-services.sh
TimeoutStartSec=3600
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
